body {
  font-family: Arial;
  background: #f4f4f4;
  padding: 20px;
}

.container {
  max-width: 600px;
  margin: auto;
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

input, select, button {
  padding: 10px;
  margin: 5px 0;
  width: 100%;
}

ul {
  list-style: none;
  padding: 0;
}

li {
  display: flex;
  justify-content: space-between;
  background: #eee;
  margin: 5px 0;
  padding: 10px;
  border-radius: 5px;
}

.income {
  color: green;
}

.expense {
  color: red;
}

button {
  cursor: pointer;
}
